# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for live runs; --dry-run needs nothing.
ANTHROPIC_API_KEY=

# Claude model and effort (defaults shown). Effort: low | medium | high | xhigh | max
FULLHOUSE_CLAUDE_MODEL=claude-opus-5-5
FULLHOUSE_CLAUDE_EFFORT=medium
# Server-side refusal fallback (beta server-side-fallback-2026-07-01). Set false to disable.
FULLHOUSE_CLAUDE_FALLBACKS=true

# Where the SQLite database, scrape cache, PDFs and outbox live.
FULLHOUSE_DATA_DIR=.fullhouse

# Scraping politeness
FULLHOUSE_USER_AGENT=FullHouseAuditBot/0.1 (+revenue audit; respects robots.txt)
FULLHOUSE_MIN_SECONDS_BETWEEN_REQUESTS=5
FULLHOUSE_CACHE_TTL_HOURS=24
# Point at an installed Chrome/Chromium if `playwright install chromium` is not an option.
FULLHOUSE_CHROMIUM_PATH=

# Business rules
FULLHOUSE_TIMEZONE=Australia/Sydney
FULLHOUSE_DIRECT_RATE_BUFFER_PCT=5

# SerpApi (Google Hotels data for `fullhouse prospect`). SerpApi takes the key as a URL parameter.
SERPAPI_API_KEY=

# Google (optional): Places API key for profile checks; OAuth token (scope business.manage) for posts, media, reviews.
GOOGLE_PLACES_API_KEY=
GBP_ACCESS_TOKEN=

# Email. Without SMTP_HOST, messages are saved to the outbox folder instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=Full House

# Sender identity printed in every outreach email (required by the Spam Act 2003).
FULLHOUSE_SENDER_NAME=Will
FULLHOUSE_SENDER_BUSINESS=Full House
FULLHOUSE_SENDER_CONTACT=

# Public address of the approvals web app (`fullhouse approvals serve`), used in email links.
FULLHOUSE_APPROVAL_BASE_URL=http://localhost:8000
FULLHOUSE_PROPOSAL_TTL_DAYS=14
